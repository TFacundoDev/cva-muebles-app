# Copiá este archivo como .env.local para trabajar en local:  cp .env.example .env.local

# URL de la API.
NEXT_PUBLIC_API_URL=http://localhost:3001
# Dominio público de la tienda (se usa en los links de WhatsApp).
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Mismo valor que REVALIDATE_SECRET de la API.
REVALIDATE_SECRET=secreto-local

# "dev" entra sin contraseña (solo en local). En producción: supabase.
NEXT_PUBLIC_AUTH_MODE=dev
# NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
# La clave pública del proyecto ("publishable" o "anon"). No es secreta.
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
