# Copiá este archivo como .env para trabajar en local:  cp .env.example .env
# Así como está, funciona con "docker compose up -d db" sin configurar nada más.

NODE_ENV=development
PORT=3001
# URL pública de esta API.
PUBLIC_API_URL=http://localhost:3001

# ---------- Base de datos ----------
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/cva_muebles
# En Supabase:
#   DATABASE_URL = "Transaction pooler" (puerto 6543)  -> la usa la API
#   DIRECT_URL   = "Session pooler" (puerto 5432)      -> la usan las migraciones
#   DATABASE_SSL = true
# DIRECT_URL=
DATABASE_SSL=false

# ---------- Web ----------
# Dominios de la tienda que pueden llamar a la API (separados por coma).
CORS_ORIGINS=http://localhost:3000
# Webs a las que se avisa cuando cambia algo (Vercel y, si está, Netlify).
WEB_URLS=http://localhost:3000
# Mismo valor que REVALIDATE_SECRET de la web. Inventá uno largo.
REVALIDATE_SECRET=secreto-local

# ---------- Login ----------
# "dev" entra sin contraseña (solo en local). En producción: supabase.
AUTH_MODE=dev
# SUPABASE_URL=https://xxxxxxxx.supabase.co
# Solo si tu proyecto de Supabase usa el secreto JWT viejo (HS256). Si no, dejalo vacío.
# SUPABASE_JWT_SECRET=
# Emails con acceso al panel, separados por coma.
OWNER_EMAILS=dueno@cva.test

# ---------- Archivos ----------
# "local" guarda en ./storage. En producción: r2.
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./storage
UPLOAD_SIGNING_SECRET=dev-secret-cambiar
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET=cva-muebles
# R2_PUBLIC_URL=https://archivos.tudominio.com.ar
# Bucket PRIVADO para los backups (sin acceso público).
# R2_BACKUP_BUCKET=cva-muebles-backups

# ---------- Tareas programadas ----------
# true solo en el servidor principal (Fly). En el de respaldo, false.
RUN_JOBS=false

# ---------- Modelos 3D con IA (opcional, pago) ----------
AI_PROVIDER=none
# AI_PROVIDER=meshy
# MESHY_API_KEY=
